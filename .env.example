# Telegram Bot (BotFather에서 발급 — 반드시 재발급 권장)
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_admin_chat_id
BOT_USERNAME=YourSignalLabBot

# 관리자 Chat ID (쉼표 구분)
ADMIN_CHAT_IDS=5936069902

# 프리미엄/VIP 초대 코드
PREMIUM_CODES=SIGNAL2026,PREMIUM
VIP_CODES=VIP2026,SIGNALVIP

# 결제 (수익 핵심!)
PAYMENT_LINK_KRW=https://your-toss-link.com
PAYMENT_LINK_USD=https://your-stripe-link.com
PAYMENT_CONTACT=@YourTelegramID

# 한국 결제 정보 (계좌이체용)
BANK_NAME=국민은행
BANK_ACCOUNT=1234567890123456
BANK_HOLDER=홍길동

# 웹사이트 설정 (실제 배포 시 변경)
WEB_DOMAIN=your-domain.com
WEB_PROTOCOL=https

# 종목
TICKERS=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMD,META,GOOGL,AMZN
FREE_TICKERS=SPY,QQQ
VIP_TICKERS=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMD,META,GOOGL,AMZN

# 요금 (표시용)
PREMIUM_PRICE_KRW=29000
PREMIUM_PRICE_USD=19.99
VIP_PRICE_KRW=59000
VIP_PRICE_USD=39.99

# 수익화 설정
TRIAL_DAYS=3
REFERRAL_BONUS_DAYS=7
FREE_WEEKLY_SIGNAL_LIMIT=2
PREMIUM_DURATION_DAYS=30
VIP_DURATION_DAYS=30

# 스케줄
SCHEDULE_TIME=22:00
UPSELL_TIME=12:00
UPSELL_ENABLED=true

# RSI / MACD
RSI_PERIOD=14
RSI_BUY_THRESHOLD=30
RSI_SELL_THRESHOLD=70
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

HISTORY_DAYS=120
HEARTBEAT_ENABLED=true
DAILY_REPORT_ENABLED=true
